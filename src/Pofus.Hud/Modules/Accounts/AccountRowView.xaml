<UserControl x:Class="Pofus.Hud.Modules.Accounts.AccountRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,3">
    <Border Style="{StaticResource Pofus.RoundSlot}"
            CornerRadius="{StaticResource Pofus.Radius.Small}"
            BorderBrush="{DynamicResource Pofus.BorderSubtle}"
            Padding="10,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="ActiveCheckBox"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      ToolTip="Compte actif"
                      Checked="OnActiveChanged"
                      Unchecked="OnActiveChanged" />

            <ToggleButton x:Name="LeaderToggle"
                          Grid.Column="1"
                          Style="{StaticResource Pofus.StarToggle}"
                          Margin="0,0,10,0"
                          ToolTip="Désigner comme leader"
                          Checked="OnLeaderChecked"
                          Unchecked="OnLeaderUnchecked" />

            <TextBlock x:Name="PseudoText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Pofus.TextPrimary}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="ClassNameText"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Pofus.TextMuted}"
                       TextTrimming="CharacterEllipsis" />

            <TextBox x:Name="TeamTextBox"
                     Grid.Column="4"
                     VerticalAlignment="Center"
                     FontSize="11"
                     LostFocus="OnTeamLostFocus" />

            <Button x:Name="MoveUpButton"
                    Grid.Column="5"
                    Content="&#x25B2;"
                    Width="24" Height="24"
                    Padding="0"
                    FontSize="9"
                    Margin="6,0,0,0"
                    ToolTip="Monter"
                    Click="OnMoveUpClick" />

            <Button x:Name="MoveDownButton"
                    Grid.Column="6"
                    Content="&#x25BC;"
                    Width="24" Height="24"
                    Padding="0"
                    FontSize="9"
                    Margin="4,0,0,0"
                    ToolTip="Descendre"
                    Click="OnMoveDownClick" />
        </Grid>
    </Border>
</UserControl>
