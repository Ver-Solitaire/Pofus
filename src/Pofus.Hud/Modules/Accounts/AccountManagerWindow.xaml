<Window x:Class="Pofus.Hud.Modules.Accounts.AccountManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus — Gestion des comptes"
        Width="560" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource Pofus.PanelBorder}" Margin="14">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Comptes Dofus" Style="{StaticResource Pofus.WindowTitle}" />
                <Button Grid.Column="1" Style="{StaticResource Pofus.CloseButton}" Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,12"
                    Background="{DynamicResource Pofus.BorderSubtle}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateText"
                               Text="Aucun compte Dofus détecté"
                               Foreground="{DynamicResource Pofus.TextMuted}"
                               Visibility="Collapsed" />
                    <StackPanel x:Name="RowsPanel" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
