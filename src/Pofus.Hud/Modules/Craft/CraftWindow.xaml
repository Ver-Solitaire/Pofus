<Window x:Class="Pofus.Hud.Modules.Craft.CraftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus — Atelier"
        Width="470" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="380" MinHeight="320"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Pofus.PanelBorder}" Margin="14">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Atelier DofusBook" Style="{StaticResource Pofus.WindowTitle}" />
                <Button Grid.Column="1" Style="{StaticResource Pofus.CloseButton}" Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,12" Background="{DynamicResource Pofus.BorderSubtle}" />

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Grid.Column="0" VerticalAlignment="Center"
                         Margin="0,0,6,0" KeyDown="OnUrlKeyDown"
                         ToolTip="Collez le lien de votre atelier DofusBook, puis Entrée" />
                <Button x:Name="ImportButton" Grid.Column="1" Content="Importer" Click="OnImportClick" />
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="RefreshButton" Content="Actualiser" Click="OnRefreshClick"
                        Margin="0,0,6,0" IsEnabled="False"
                        ToolTip="Relire l'atelier depuis DofusBook, en conservant vos cases cochées" />
                <ToggleButton x:Name="ShowEquipmentToggle" Content="Voir les équipements"
                              Checked="OnToggleEquipmentChanged" Unchecked="OnToggleEquipmentChanged"
                              ToolTip="Afficher la liste des équipements à fabriquer" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource Pofus.TextPrimary}" />

            <TextBlock x:Name="SummaryText" Grid.Row="5" Margin="0,0,0,8"
                       Foreground="{DynamicResource Pofus.TextPrimary}" FontWeight="SemiBold" />

            <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateText"
                               Text="Collez le lien de votre atelier ci-dessus, puis Importer."
                               Foreground="{DynamicResource Pofus.TextMuted}" />

                    <StackPanel x:Name="ResourceRowsPanel" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="ProgressText" Grid.Row="7" Margin="0,10,0,0"
                       Foreground="{DynamicResource Pofus.TextMuted}" />
        </Grid>
        </Border>

        <!--
            The "big picture" extension. It is a panel of the same window rather
            than a second window, so it moves, resizes and stays on top with the
            list instead of having to be kept in sync with it.
        -->
        <Border x:Name="BigPicturePanel" Grid.Column="1" Visibility="Collapsed"
                Style="{StaticResource Pofus.PanelBorder}" Margin="0,14,14,14" Width="452">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Équipements à fabriquer"
                           Style="{StaticResource Pofus.WindowTitle}" />
                <Border Grid.Row="1" Height="1" Margin="0,12"
                        Background="{DynamicResource Pofus.BorderSubtle}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="EquipmentTilesPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
