<Window x:Class="Pofus.Hud.Modules.Navigation.NavigationShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus — Raccourcis"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource Pofus.PanelBorder}" Margin="14">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Grid.ColumnSpan="3" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Raccourcis" Style="{StaticResource Pofus.WindowTitle}" />
                <Button Grid.Column="1" Style="{StaticResource Pofus.CloseButton}" Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Margin="0,12"
                    Background="{DynamicResource Pofus.BorderSubtle}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Compte suivant"
                       Foreground="{DynamicResource Pofus.TextPrimary}" VerticalAlignment="Center" Margin="0,6" />
            <TextBlock x:Name="NextText" Grid.Row="2" Grid.Column="1"
                       Foreground="{DynamicResource Pofus.TextMuted}" VerticalAlignment="Center" />
            <Button x:Name="ModifyNextButton" Grid.Row="2" Grid.Column="2" Content="Modifier"
                    Click="OnModifyNextClick" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Compte précédent"
                       Foreground="{DynamicResource Pofus.TextPrimary}" VerticalAlignment="Center" Margin="0,6" />
            <TextBlock x:Name="PreviousText" Grid.Row="3" Grid.Column="1"
                       Foreground="{DynamicResource Pofus.TextMuted}" VerticalAlignment="Center" />
            <Button x:Name="ModifyPreviousButton" Grid.Row="3" Grid.Column="2" Content="Modifier"
                    Click="OnModifyPreviousClick" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Aller au leader"
                       Foreground="{DynamicResource Pofus.TextPrimary}" VerticalAlignment="Center" Margin="0,6" />
            <TextBlock x:Name="LeaderText" Grid.Row="4" Grid.Column="1"
                       Foreground="{DynamicResource Pofus.TextMuted}" VerticalAlignment="Center" />
            <Button x:Name="ModifyLeaderButton" Grid.Row="4" Grid.Column="2" Content="Modifier"
                    Click="OnModifyLeaderClick" />

            <Border Grid.Row="5" Grid.ColumnSpan="3" Height="1" Margin="0,16"
                    Background="{DynamicResource Pofus.BorderSubtle}" />

            <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="Réafficher une fenêtre"
                       Foreground="{DynamicResource Pofus.TextPrimary}"
                       FontWeight="SemiBold" Margin="0,0,0,4" />

            <!-- One row per hideable window, built in code (the set grows as
                 new windows are declared hideable). -->
            <StackPanel x:Name="PanelRowsPanel" Grid.Row="7" Grid.ColumnSpan="3" />

            <TextBlock x:Name="StatusText" Grid.Row="8" Grid.ColumnSpan="3"
                       Foreground="{StaticResource Pofus.Accent}"
                       Margin="0,14,0,0" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
