<Window x:Class="Pofus.Hud.Modules.Settings.ConflictWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus — Conflit logiciel détecté"
        Width="440" Height="230"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource Pofus.PanelBorder}" Margin="14">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Conflit logiciel détecté" Style="{StaticResource Pofus.WindowTitle}" />

            <Border Grid.Row="1" Height="1" Margin="0,12" Background="{DynamicResource Pofus.BorderSubtle}" />

            <TextBlock x:Name="MessageText" Grid.Row="2"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Pofus.TextPrimary}" />

            <TextBlock x:Name="StatusText" Grid.Row="3"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Pofus.Danger}" />

            <CheckBox x:Name="IgnoreCheckBox" Grid.Row="4" Margin="0,8,0,0"
                      Content="Ne plus m'avertir de ce conflit" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="ContinueButton" Content="Continuer sans fermer" Margin="0,0,8,0"
                        Click="OnContinueClick" />
                <Button x:Name="CloseConflictButton" Content="Fermer le logiciel"
                        Click="OnCloseConflictClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
