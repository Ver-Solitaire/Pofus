<UserControl x:Class="Pofus.Hud.Controls.ModuleSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Empty slots stay a small fixed circle (placeholder for a future
        module). Occupied slots grow to fit their hosted content while
        keeping the same rounded-pill chrome, rather than squeezing a real
        control's text into a rigid 36x36 circle.
    -->
    <Border x:Name="SlotBorder" Style="{StaticResource Pofus.RoundSlot}"
            MinWidth="36" MinHeight="36" Padding="4">
        <TextBlock x:Name="SlotLabelText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="8"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Pofus.TextMuted}" />
    </Border>
</UserControl>
