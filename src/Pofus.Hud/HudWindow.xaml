<Window x:Class="Pofus.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootPanel"
            Style="{StaticResource Pofus.PanelBorder}"
            Padding="14,9"
            MouseLeftButtonDown="OnRootPanelMouseLeftButtonDown">
        <StackPanel x:Name="ModuleSlotsPanel" Orientation="Horizontal" />
    </Border>
</Window>
