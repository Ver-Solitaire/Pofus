<Window x:Class="Pofus.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootPanel"
            Style="{StaticResource Pofus.PanelBorder}"
            Padding="8,9,14,9"
            MouseLeftButtonDown="OnRootPanelMouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <!--
                Explicit drag handle. The modules fill nearly the whole bar, so
                dragging used to mean hitting the few pixels between buttons;
                this gives a target that is always there and reads as grabbable.
            -->
            <Border x:Name="DragHandle"
                    Width="18" Margin="0,0,6,0"
                    Background="Transparent"
                    Cursor="SizeAll"
                    ToolTip="Glisser pour déplacer le HUD"
                    MouseLeftButtonDown="OnRootPanelMouseLeftButtonDown">
                <UniformGrid Columns="2" Rows="3" Width="10" Height="16"
                             VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource Pofus.TextMuted}" />
                    <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource Pofus.TextMuted}" />
                    <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource Pofus.TextMuted}" />
                    <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource Pofus.TextMuted}" />
                    <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource Pofus.TextMuted}" />
                    <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource Pofus.TextMuted}" />
                </UniformGrid>
            </Border>

            <StackPanel x:Name="ModuleSlotsPanel" Orientation="Horizontal" />

            <!--
                Quitting Pofus. Set apart from the modules by a rule and a gap:
                the bar floats over the game, and a control that ends the session
                should not sit flush against the ones used constantly.
            -->
            <Border Width="1" Margin="10,6,0,6"
                    Background="{DynamicResource Pofus.BorderSubtle}" />
            <Button x:Name="QuitButton"
                    Style="{StaticResource Pofus.CloseButton}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Quitter Pofus"
                    Click="OnQuitClick" />
        </StackPanel>
    </Border>
</Window>
