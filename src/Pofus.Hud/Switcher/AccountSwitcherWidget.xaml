<Window x:Class="Pofus.Hud.Switcher.AccountSwitcherWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pofus — Comptes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootPanel"
            Style="{StaticResource Pofus.PanelBorder}"
            Padding="8"
            MouseLeftButtonDown="OnRootPanelMouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="EmptyStateText"
                       Text="Aucun compte Dofus détecté"
                       Foreground="{DynamicResource Pofus.TextMuted}"
                       VerticalAlignment="Center"
                       Margin="6,0"
                       Visibility="Collapsed" />
            <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" />
        </StackPanel>
    </Border>
</Window>
