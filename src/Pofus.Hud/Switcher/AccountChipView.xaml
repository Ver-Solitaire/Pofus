<UserControl x:Class="Pofus.Hud.Switcher.AccountChipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand">
    <Grid Width="52" Height="52">
        <!--
            Leader marker: a white circle that breathes (scale + opacity) with
            an iridescent sheen sweeping around it. The sheen is a gradient
            stroke whose RelativeTransform is rotated continuously.
        -->
        <Ellipse x:Name="LeaderHalo" Width="48" Height="48"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 StrokeThickness="2" Fill="Transparent"
                 Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                 IsHitTestVisible="False">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="LeaderHaloSheen" CenterX="0.5" CenterY="0.5" Angle="0" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                    <GradientStop Color="#FF9BE8FF" Offset="0.25" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                    <GradientStop Color="#FFE3B4FF" Offset="0.75" />
                    <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="LeaderHaloScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFBFF2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
            </Ellipse.Effect>
        </Ellipse>
        <Border x:Name="Ring" Width="42" Height="42"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="{StaticResource Pofus.Radius.Control}"
                BorderThickness="2"
                Background="{DynamicResource Pofus.SurfaceRaised}"
                MouseLeftButtonDown="OnMouseLeftButtonDown">
            <Border.BorderBrush>
                <SolidColorBrush Color="Transparent" />
            </Border.BorderBrush>
            <Border x:Name="ClassBadge" Width="34" Height="34" CornerRadius="8" />
        </Border>
    </Grid>
</UserControl>
