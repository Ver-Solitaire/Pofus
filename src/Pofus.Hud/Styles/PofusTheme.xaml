<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design system for Pofus: a clean, modern dark UI (not a literal replica
        of Dofus's in-game panels) — flat surfaces, a single gold accent, and
        custom-drawn controls so nothing falls back to default Windows chrome.
    -->

    <!-- ===== Tokens: colors (kept separate from brushes so hover states can animate) ===== -->
    <Color x:Key="Pofus.Bg.Color">#FF14141A</Color>
    <Color x:Key="Pofus.Surface.Color">#FF1E1E26</Color>
    <Color x:Key="Pofus.SurfaceRaised.Color">#FF262631</Color>
    <Color x:Key="Pofus.SurfaceHover.Color">#FF32323F</Color>
    <Color x:Key="Pofus.BorderSubtle.Color">#FF34343F</Color>
    <Color x:Key="Pofus.BorderStrong.Color">#FF46464F</Color>
    <Color x:Key="Pofus.Accent.Color">#FFD4A64A</Color>
    <Color x:Key="Pofus.TextPrimary.Color">#FFF2EEE6</Color>
    <Color x:Key="Pofus.TextMuted.Color">#FF9A9AA5</Color>
    <Color x:Key="Pofus.TextDisabled.Color">#FF5A5A63</Color>
    <Color x:Key="Pofus.Danger.Color">#FFE5484D</Color>

    <!-- ===== Tokens: brushes (static usage) ===== -->
    <SolidColorBrush x:Key="Pofus.Bg" Color="{StaticResource Pofus.Bg.Color}" />
    <SolidColorBrush x:Key="Pofus.Surface" Color="{StaticResource Pofus.Surface.Color}" />
    <SolidColorBrush x:Key="Pofus.SurfaceRaised" Color="{StaticResource Pofus.SurfaceRaised.Color}" />
    <SolidColorBrush x:Key="Pofus.BorderSubtle" Color="{StaticResource Pofus.BorderSubtle.Color}" />
    <SolidColorBrush x:Key="Pofus.BorderStrong" Color="{StaticResource Pofus.BorderStrong.Color}" />
    <SolidColorBrush x:Key="Pofus.Accent" Color="{StaticResource Pofus.Accent.Color}" />
    <SolidColorBrush x:Key="Pofus.TextPrimary" Color="{StaticResource Pofus.TextPrimary.Color}" />
    <SolidColorBrush x:Key="Pofus.TextMuted" Color="{StaticResource Pofus.TextMuted.Color}" />
    <SolidColorBrush x:Key="Pofus.TextDisabled" Color="{StaticResource Pofus.TextDisabled.Color}" />
    <SolidColorBrush x:Key="Pofus.Danger" Color="{StaticResource Pofus.Danger.Color}" />

    <!-- ===== Tokens: typography =====
         Segoe UI Variable is the Windows 11 UI face: better spacing and a
         cleaner skeleton than plain Segoe UI, and it ships with the system, so
         nothing has to be embedded. Display is optically sized for headings,
         Text for body copy; both fall back to Segoe UI on Windows 10. -->
    <FontFamily x:Key="Pofus.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Pofus.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ===== Tokens: shape/depth ===== -->
    <CornerRadius x:Key="Pofus.Radius.Panel">14</CornerRadius>
    <CornerRadius x:Key="Pofus.Radius.Control">7</CornerRadius>
    <CornerRadius x:Key="Pofus.Radius.Small">5</CornerRadius>
    <CornerRadius x:Key="Pofus.Radius.Slot">20</CornerRadius>
    <!-- Wider, softer and further from the surface than a default shadow:
         these windows float over a busy game, and need to read as separate. -->
    <DropShadowEffect x:Key="Pofus.Shadow.Panel" Color="Black" Opacity="0.55" BlurRadius="28" ShadowDepth="6" Direction="270" />

    <!-- ===== Baseline text ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Pofus.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Pofus.TextPrimary}" />
    </Style>

    <!-- ===== Panels ===== -->
    <Style x:Key="Pofus.PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pofus.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pofus.Accent}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{StaticResource Pofus.Radius.Panel}" />
        <Setter Property="Effect" Value="{StaticResource Pofus.Shadow.Panel}" />
    </Style>

    <!-- ===== Context menu (feature 005): custom-drawn so slot menus don't fall
         back to stock Windows chrome, consistent with every other control here ===== -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Pofus.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Pofus.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Pofus.Radius.Small}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pofus.SurfaceRaised}" />
                            <Setter Property="Foreground" Value="{StaticResource Pofus.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Pofus.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Pofus.Surface}"
                            BorderBrush="{DynamicResource Pofus.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Pofus.Radius.Control}"
                            Padding="4"
                            Effect="{StaticResource Pofus.Shadow.Panel}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pofus.RoundSlot" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pofus.SurfaceRaised}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{StaticResource Pofus.Radius.Slot}" />
    </Style>

    <!-- ===== Window header (custom chrome — see AccountManagerWindow / NavigationShortcutsWindow) ===== -->
    <Style x:Key="Pofus.WindowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Pofus.Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <!-- Slight negative tracking: at heading sizes Segoe UI Variable reads
             tighter and more deliberate. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Pofus.CloseButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Pofus.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Pofus.Radius.Small}" Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#x2715;" FontSize="10" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pofus.Danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Pofus.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons — flat, rounded, smooth hover fade ===== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Pofus.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Pofus.Font.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            CornerRadius="{StaticResource Pofus.Radius.Control}"
                            BorderThickness="1.2"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource Pofus.SurfaceRaised.Color}" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource Pofus.BorderSubtle.Color}" />
                        </Border.BorderBrush>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Chrome"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource Pofus.SurfaceHover.Color}" Duration="0:0:0.12" />
                                        <ColorAnimation Storyboard.TargetName="Chrome"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="{StaticResource Pofus.Accent.Color}" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Chrome"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource Pofus.SurfaceRaised.Color}" Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="Chrome"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="{StaticResource Pofus.BorderSubtle.Color}" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox — custom box + checkmark, no default OS glyph ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Pofus.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                BorderThickness="1.4" VerticalAlignment="Center">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource Pofus.BorderStrong.Color}" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>
                            <Path x:Name="Check" Data="M2,6 L5,9.5 L11,2.5" Stroke="{DynamicResource Pofus.Bg}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Opacity="0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Pofus.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Pofus.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Pofus.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Leader star toggle (AccountRowView) ===== -->
    <Style x:Key="Pofus.StarToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="11" BorderThickness="1.4">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource Pofus.BorderStrong.Color}" />
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="Transparent" />
                        </Border.Background>
                        <TextBlock x:Name="StarText" Text="&#x2605;" FontSize="11" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Pofus.TextDisabled}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pofus.Accent}" />
                            <Setter TargetName="StarText" Property="Foreground" Value="{StaticResource Pofus.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pofus.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox — flat, focus glow instead of the default OS inset border ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Pofus.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Pofus.Accent}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Pofus.Radius.Small}"
                            BorderThickness="1.4" Background="{DynamicResource Pofus.SurfaceRaised}">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource Pofus.BorderSubtle.Color}" />
                        </Border.BorderBrush>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pofus.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbar — thin, unobtrusive thumb, no default OS arrows/track ===== -->
    <Style x:Key="Pofus.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{DynamicResource Pofus.BorderStrong}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Pofus.ScrollBarThumb}" Width="6" />
                        </Track.Thumb>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
